# ============================================================
# Cell.id.vn — biến môi trường
# ------------------------------------------------------------
# Local dev:  copy file này thành `.env` (cùng thư mục server.js) rồi sửa.
# Production: file /opt/cell-tracker/shared/.env (chmod 600), systemd nạp qua
#             EnvironmentFile. KHÔNG commit file `.env` thật.
# ============================================================

# development | production
# production ⇒ BẮT BUỘC có JWT_SECRET khác giá trị mặc định (server tự thoát nếu thiếu),
# và guest cookie luôn bật cờ Secure (phải chạy sau HTTPS).
NODE_ENV=development

# Cổng HTTP của Node
PORT=3000

# Interface để listen. Production đặt 127.0.0.1 (chỉ Nginx gọi tới).
# Bỏ trống = nghe mọi interface (giống hành vi cũ, tiện cho LAN/dev).
# HOST=127.0.0.1

# Tin header X-Forwarded-* của reverse proxy (số hop, hoặc 'loopback'/'10.0.0.0/8').
# BẮT BUỘC =1 khi chạy sau Nginx, nếu không link trong email / returnUrl payOS sẽ ra http://.
# TRUST_PROXY=1

# Khoá ký JWT — sinh bằng: openssl rand -hex 32
# Không đặt ở production ⇒ server dừng hẳn. Local có thể bỏ trống (dùng mặc định).
# JWT_SECRET=

# Khoá ký cookie guest trial — sinh bằng: openssl rand -hex 32
# Không đặt ⇒ khoá ngẫu nhiên mỗi lần khởi động (guest mất "lượt thử" cũ sau restart).
# GUEST_SECRET=

# ---- Đường dẫn dữ liệu (production: nằm ngoài thư mục release) ----
# File SQLite. Bỏ trống = thư mục CHA của repo (hành vi cũ cho local).
# DB_PATH=/opt/cell-tracker/shared/database.sqlite
# Thư mục file người dùng tải lên. Bỏ trống = <repo>/uploads
# UPLOAD_DIR=/opt/cell-tracker/shared/uploads

# HTTPS tự ký cho LAN (PWA trên điện thoại). Production = 0 (TLS do Nginx/certbot lo).
HTTPS_PORT=0

# ---- API key nguồn dữ liệu: chỉ dùng nếu không khai báo trong Admin ▸ Nguồn ----
# OPENCELLID_API_KEY=
# COMBAIN_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Dùng cho script test (bật = tắt rate limit auth/captcha). KHÔNG bật ở production.
# AUTH_TEST_NO_RATELIMIT=0
