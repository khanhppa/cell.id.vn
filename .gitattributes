# ============================================================================
# .gitattributes — quy tắc xuống dòng + phạm vi `git archive` (artifact deploy)
# ----------------------------------------------------------------------------
# Repo dev trên Windows (core.autocrlf=true) nhưng script triển khai được bash
# chạy trực tiếp trên Linux: nếu working tree có CRLF, bash chết với
# `bad interpreter: /bin/bash^M` hoặc `$'\r': command not found`.
# → ép LF cho *.sh cả trong repo lẫn working tree.
# ============================================================================
*.sh                text eol=lf
*.ps1               text eol=crlf
deploy/ci/sudoers-* text eol=lf
*.js                text eol=lf
*.json              text eol=lf
*.md                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf

# ============================================================================
# `git archive` (nguồn artifact cho deploy.ps1 và GitHub Actions)
# Chỉ ảnh hưởng export, KHÔNG ảnh hưởng clone/checkout.
# ============================================================================
# Secrets / cấu hình theo máy
.env                export-ignore
.env.*              export-ignore

# Dữ liệu runtime
*.log               export-ignore
*.tmp               export-ignore
*.sqlite            export-ignore
*.sqlite.*          export-ignore
uploads/            export-ignore
dist/               export-ignore
backups/            export-ignore
release-artifacts/  export-ignore
.tools/             export-ignore
.certs/             export-ignore
.vscode/            export-ignore

# Dev-only: script vận hành, hạ tầng CI/CD, tài liệu
scripts/            export-ignore
deploy/             export-ignore
.github/            export-ignore
audit-*.txt         export-ignore
README.md           export-ignore
API.md              export-ignore
