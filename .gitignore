# Dependencies
node_modules/

# Runtime data / uploads (server recreates these dirs on start)
uploads/
database.sqlite
database.sqlite.corrupt

# Secrets / cấu hình theo máy (xem .env.example)
.env
.env.*
!.env.example

# Artifact build/deploy (deploy.ps1 tạo zip ở đây)
dist/
backups/
release-artifacts/
*.tar.gz
coverage/

# File nháp/probe khi debug (không bao giờ commit — có thể chứa token)
.probe*
*.tmp

# Logs
*.log
server.err

# Downloaded / large data files
*.csv
*.csv.gz
*.gz
# but keep bundled sample CSVs used by the app
!public/sample_*.csv

# Office lock/temp files
~$*

# Editor
.vscode/

# Chứng chỉ TLS tự ký cho LAN (sinh khi bật HTTPS_PORT) — không commit khoá riêng
.certs/

# Công cụ tải tại chỗ (cloudflared…) + log tunnel
.tools/

